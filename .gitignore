# aggregate document frequencies only, no corpus text -- required at
# runtime, and unbuildable without the (gitignored) Kaggle resume corpus
!data/processed/bm25_corpus_stats.json
# derived ESCO adjacency map: the CSVs it comes from are 36MB and
# ESCO-licensed, so the derived map is what ships (scripts/build_adjacency_cache.py)
!data/processed/esco_adjacency.json.gz
data/taxonomy/*
!data/taxonomy/.gitkeep
.cache/
*.pt
*.bin
.DS_Store
.vscode/
.idea/
.ipynb_checkpoints/
*.log
venv.nosync/
# pasted job postings: employer copy, not ours to republish
data/jds/
# resumes uploaded through the UI: personal data, stays local.
# streamlit_app.py deletes each file straight after parsing -- the text
# and the preview live in the database -- but the directory is ignored
# so a crash between write and unlink cannot leak one into git.
data/uploads/

# deploy staging tree (scripts/prepare_deploy.py)
build/

.agents/
.claude/
