# Postgres with the pgvector extension (Supabase works; use the session
# pooler connection string, port 5432)
DATABASE_URL=postgresql://user:password@localhost:5432/resume_matcher

# Adzuna: used to *find* postings only. Its API truncates descriptions at
# 500 characters, so postings are loaded from company job boards
# (Greenhouse/Lever/Ashby, no key needed) or pasted in.
ADZUNA_APP_ID=app_id_here
ADZUNA_APP_KEY=app_key_here

# App config
APP_ENV=development

# Not currently used -- kept for the stretch goals in docs/ROADMAP.md:
#   REED_API_KEY       (second job-posting source)
#   ANTHROPIC_API_KEY  (LLM rewrite suggestions, not built)
